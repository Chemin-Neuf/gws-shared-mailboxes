# Normalize text files to LF by default
* text=auto eol=lf

# Windows batch files require CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Explicitly declare common text files
*.ps1   text eol=lf
*.psm1  text eol=lf
*.psd1  text eol=lf
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
.editorconfig  text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# Binary files - never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.7z    binary
*.pdf   binary
*.exe   binary
*.dll   binary
*.ttf   binary
*.otf   binary
*.mp3   binary
*.mp4   binary
*.webp  binary